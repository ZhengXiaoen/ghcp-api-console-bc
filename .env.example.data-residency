# GHE.com (GitHub Enterprise Cloud with data residency) example.
# Copy this file to .env before running docker compose and replace sample-ent with your
# GHE.com subdomain / enterprise slug.
# Replace every change-me value before deploying outside local development.

LOG_LEVEL=info

# Shared internal/API secrets.
API_KEY=change-me-proxy-api-key
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_SECRET=change-me-session-secret

# Host ports exposed by docker compose.
PROXY_PORT=3000
SSO_PORT=7001
LOGIN_PORT=7003
CONSOLE_PORT=7004

# Proxy public API and OpenCode-compatible Copilot authentication.
STORAGE_DRIVER=sqlite
DB_PATH=/data/proxy.sqlite
# Required when STORAGE_DRIVER=mysql. Use a shared external MySQL 8 database in production.
MYSQL_URL=
MYSQL_AUTO_MIGRATE=true
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL_MODE=disabled
MYSQL_SSL_CA_PATH=
IDENTITY_INIT_LEASE_SECONDS=900
IDENTITY_HEADER=X-User-Identity
IDENTITY_HEADER_REQUIRED=true
# Default Claude Code mode; requests can override with X-Claude-Code-Optimized.
CLAUDE_CODE_OPTIMIZED=true
REQUEST_STATS_PER_ACCOUNT_LIMIT=2
PROXY_ERROR_DIAGNOSTICS_ENABLED=true
PROXY_ERROR_DIAGNOSTICS_DIR=/data/error-diagnostics
PROXY_ERROR_DIAGNOSTICS_REDACT=false
PROXY_ERROR_DIAGNOSTICS_MAX_FILE_MB=50
PROXY_ERROR_DIAGNOSTICS_MAX_FILES=5
# For multiple Proxy Pods, mount one RWX volume at PROXY_ERROR_DIAGNOSTICS_DIR.
PROXY_ERROR_DIAGNOSTICS_SHARED=false
PROXY_INSTANCE_ID=

GITHUB_OAUTH_CLIENT_ID=Ov23li8tweQw6odWQebz
GITHUB_OAUTH_SCOPE=read:user
COPILOT_API_BASE_URL=https://copilot-api.sample-ent.ghe.com
OPENCODE_VERSION=1.18.4
GITHUB_API_VERSION=2026-06-01

# SSO/SAML settings. This base URL must match the IdP URLs configured in GitHub.
SSO_PUBLIC_BASE_URL=http://sso:7001
SSO_CERT_DIR=./certs
SP_ENTITY_ID=https://sample-ent.ghe.com/enterprises/sample-ent
SP_ACS_URL=https://sample-ent.ghe.com/enterprises/sample-ent/saml/consume
SSO_DEFAULT_USER_PASSWORD=

# GitHub Enterprise / SCIM / Copilot settings.
# GHE.com web origin. Login opens <GITHUB_BASE_URL>/enterprises/<ENTERPRISE_SLUG>/sso,
# clicks Continue and signs in on SSO; no GitHub username is entered.
GITHUB_BASE_URL=https://sample-ent.ghe.com
ENTERPRISE_SLUG=sample-ent
# Not used on GHE.com: the shortcode is hidden and the GHE.com API rejects suffixed usernames,
# so SSO/Proxy ignore ENTERPRISE_SHORTCODE and use GH login = <ssoUser> (max 30 characters).
# ENTERPRISE_SHORTCODE=
GITHUB_API_BASE_URL=https://api.sample-ent.ghe.com
SCIM_BASE_URL=https://api.sample-ent.ghe.com/scim/v2/enterprises/sample-ent
SCIM_TOKEN=change-me-scim-token
GITHUB_COPILOT_SEAT_PAT=change-me-github-pat

# Login worker settings.
# In Compose, use the SSO service name; 127.0.0.1 would point to the login container itself.
LOGIN_SSO_URL=http://sso:7001/login
AUTH_HEADLESS=true
